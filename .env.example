# Optional: load data from a local JSON file instead of the API (no credentials needed)
# DATA_FILE=api_dump_443486_finished.json
WEBSCORER_API_ID=
WEBSCORER_API_TOKEN=
# Optional: if omitted, app prompts for race selection at startup
WEBSCORER_RACE_ID=
# Optional: polling interval in seconds (default 60)
REFRESH_INTERVAL=60
# Optional: seconds the summary page displays (default 20)
SUMMARY_DISPLAY_TIME=20
# Optional: scroll speed in pixels per second (default 100)
SCROLL_SPEED=100
# Optional: seconds to pause before and after scroll (default 2)
SCROLL_PAUSE_TIME=2
# Optional: number of leader rows pinned at top (default 3)
PINNED_LEADERS=3
# Which pages to display (true/false)
SHOW_SUMMARY=true
SHOW_OVERALL_RESULTS=true
SHOW_CATEGORY_RESULTS=true
# Optional: show pinned leaders row + medal coloring on Overall-tier pages (default false)
PINNED_LEADERS_ON_OVERALL_RESULTS=false
# Optional: Overall result table layout (standard or detailed, default standard)
OVERALL_RESULTS_LAYOUT=standard
# Optional: show in-progress result pages before racers finish (default false)
DISPLAY_UNFINISHED_IN_CATEGORY=false
DISPLAY_UNFINISHED_IN_OVERALL=false
# Optional: minutes per bucket in the finish chart (default 15)
CHART_BUCKET_MINUTES=15
# Optional: color scheme (dark or light, default: dark)
COLOR_SCHEME=dark
