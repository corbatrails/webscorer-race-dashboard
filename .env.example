WEBSCORER_API_ID=
WEBSCORER_API_TOKEN=
# Optional: if omitted, app prompts for race selection at startup
WEBSCORER_RACE_ID=
# Optional: polling interval in seconds (default 60)
REFRESH_INTERVAL=60
# Optional: page display time in seconds (default 20)
PAGE_ROTATION_INTERVAL=20
# Optional: rows per page, 0 = auto-fit to screen (default 0)
RESULTS_PER_PAGE=0
# Required: which pages to display (true/false)
SHOW_SUMMARY=true
SHOW_CATEGORIES=true
